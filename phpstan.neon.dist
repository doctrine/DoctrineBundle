includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
parameters:
   level: 8
   reportUnmatchedIgnoredErrors: true
   ignoreErrors:
      # The DBAL messenger middlewares exist since symfony/doctrine-bridge 8.2, which is not released yet
      -
         message: '~^Class Symfony\\Bridge\\Doctrine\\Messenger\\DoctrineDbal\w+Middleware not found\.$~'
         identifier: class.notFound
         reportUnmatched: false
      # The method_exists() check is always true when symfony/config provides the method, and the
      # method is added in Symfony 8.2. The entry is unmatched with a version that does not have it.
      -
         message: '#^Call to function method_exists\(\) with .* and .*acceptElementsAtPar.* will always evaluate to true\.$#'
         identifier: function.alreadyNarrowedType
         path: src/DependencyInjection/Configuration.php
         reportUnmatched: false
   paths:
      - config
      - src
      - tests
   scanFiles:
      - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
   symfony:
       constantHassers: false
       containerXmlPath: var/cache/test/Doctrine_Bundle_DoctrineBundle_Tests_DependencyInjection_Fixtures_TestKernelTestDebugContainer.xml
